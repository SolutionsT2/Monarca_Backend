# Copiar automáticamente .env.example a .env si no existe
if [ ! -f .env ] && [ -f .env.example ]; then
  echo ""
  echo "📝 Copiando .env.example a .env..."
  echo ""
  cp .env.example .env
fi

# Cargar .env
dotenv .env

# Detectar si estamos en Windows (MSYS/MINGW = gitbash) o Unix
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    # Windows con gitbash: nvm-windows es un ejecutable,
    # no necesita source de nvm.sh
    if command -v nvm &> /dev/null; then
      if [ -f .nvmrc ]; then
        nvm use "$(cat .nvmrc)"
      else
        echo "22.14.0" > .nvmrc
        nvm install 22.14.0
        nvm use 22.14.0
      fi
    else
      echo "⚠️  nvm-windows no encontrado en PATH."
      echo "   Instálalo desde: https://github.com/coreybutler/nvm-windows"
    fi
    ;;
  *)
    # Linux / macOS: nvm se carga desde nvm.sh
    export NVM_DIR="$HOME/.nvm"
    if [ -s "$NVM_DIR/nvm.sh" ]; then
      source "$NVM_DIR/nvm.sh"
    else
      echo "⚠️  No se encontró nvm.sh. ¿Está bien instalado nvm?"
    fi

    if [ -f .nvmrc ]; then
      nvm use
    else
      echo "22.14.0" > .nvmrc
      nvm install 22.14.0
      nvm use
    fi
    ;;
esac

echo ""
echo "🌱 Ambiente de desarrollo cargado para el backend"
echo "📦 Usando Node.js $(node -v)"
echo ""